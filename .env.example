APP_NAME=Nexo POS
APP_ENV=development
APP_VERSION=1.0.0-dev
PORT=3000

# PostgreSQL
# DEV: usa una base de pruebas.
# PROD: usa una base exclusiva del cliente.
DATABASE_URL=postgres://usuario:password@localhost:5432/nexo_pos_dev

# Usa require cuando el proveedor de nube lo pida.
PGSSLMODE=disable

# Clave para entrar al panel /admin.
# En desarrollo puedes poner algo simple, en produccion usa una clave larga.
ADMIN_KEY=cambia-esta-clave

# Dominio publico real (sin barra al final), usado para armar los
# enlaces de los correos. En desarrollo dejalo vacio -- sin esto,
# los enlaces usan automaticamente localhost.
APP_BASE_URL=

# Resend (correo transaccional): verificacion de cuenta, recuperacion
# de contrasena. Consigue tu API key en https://resend.com/api-keys
RESEND_API_KEY=
# Remitente de los correos. Mientras no verifiques un dominio propio
# en Resend, usa su remitente de pruebas onboarding@resend.dev.
RESEND_FROM=onboarding@resend.dev

# Stripe (cobro de suscripciones). En desarrollo usa SIEMPRE llaves de
# modo prueba (sk_test_..., whsec_... del endpoint de prueba). Sin
# estas variables, /suscripcion/* responde que Stripe no esta
# configurado en vez de fallar -- el resto del sistema no depende de
# esto para funcionar.
STRIPE_SECRET_KEY=
# Llave publica -- se manda al navegador (Payment Element del checkout de
# Nexo Market), no es secreta, seguro incluirla en el HTML.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs (no Product IDs) de cada plan, creados en el dashboard de
# Stripe o via API.
STRIPE_PRICE_BASICO=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
# Webhook de Stripe Connect (pagos reales de Nexo Market a cada
# ferreteria) -- endpoint distinto al de suscripciones, Stripe exige un
# secreto de firma propio por endpoint de webhook. Se crea al configurar
# Connect en el dashboard de Stripe apuntando a /webhooks/stripe-connect.
STRIPE_WEBHOOK_SECRET_CONNECT=

# Nexo IA (chat con datos reales del negocio). Consigue tu API key en
# https://console.anthropic.com/settings/keys -- a diferencia de
# Stripe, no existe "modo prueba": cada mensaje tiene costo real. Sin
# esta variable, /ia/chat responde que Nexo IA no esta configurado en
# vez de fallar -- el resto del sistema no depende de esto.
ANTHROPIC_API_KEY=

# Correo del operador de la plataforma al que se manda el respaldo
# automatico diario de la base completa (no es un correo por negocio).
# Sin esta variable, el respaldo sigue corriendo y queda registrado en
# la bitacora, solo no se envia por correo.
RESPALDO_EMAIL_DESTINO=

# Push notifications (web push, cliente y dueno). Genera un par nuevo
# con: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Sin estas variables, /push/vapid-public-key responde que no esta
# configurado y las rutas de suscripcion/envio no truenan, solo no
# hacen nada -- el resto del sistema no depende de esto.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@tudominio.com

# "Continuar con Google" (login/registro de personas). Se crean en
# https://console.cloud.google.com/apis/credentials -- tipo "Aplicacion
# web", con GOOGLE_REDIRECT_URI dado de alta ahi como URI de
# redireccionamiento autorizado. Sin estas variables el boton de
# Google del wizard de Nexo Market simplemente no aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.tudominio.com/personas/oauth/google/callback

# Facturacion electronica (timbrado CFDI 4.0 real via Facturama, API
# Multiemisor). Una sola cuenta de Facturama a nivel plataforma para
# todos los negocios -- cada negocio sube su propio CSD, que Facturama
# resguarda de su lado (Nexo nunca lo guarda). Sandbox gratuito en
# https://apisandbox.facturama.mx. Sin estas variables, /facturacion/*
# responde que la funcion no esta configurada en vez de tronar.
FACTURAMA_API_URL=https://apisandbox.facturama.mx
FACTURAMA_API_USER=
FACTURAMA_API_PASSWORD=
